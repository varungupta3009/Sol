<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.vrg.sol.identity-sync</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/python3</string>
        <string>/Users/vrg/Documents/Sol/scripts/identity_sync.py</string>
        <string>--from-lldap</string>
        <string>--apply</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>WatchPaths</key>
    <array>
        <string>/Users/vrg/Documents/Sol/data/lldap/users.db</string>
        <string>/Users/vrg/Documents/Sol/data/lldap/users.db-wal</string>
    </array>
    <key>ThrottleInterval</key>
    <integer>15</integer>
    <key>StandardOutPath</key>
    <string>/Users/vrg/Documents/Sol/logs/identity_sync.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/vrg/Documents/Sol/logs/identity_sync.err.log</string>
</dict>
</plist>
