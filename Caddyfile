# Homebox Physical Inventory Manager (Tinyauth v5 Trial; CORS restricted to https://scan.vrg.rocks)
inv.vrg.rocks {
	import optimize
	import security_headers
	import tinyauth

	@allowed_origins header Origin https://scan.vrg.rocks
	header @allowed_origins {
		Access-Control-Allow-Origin "https://scan.vrg.rocks"
		Access-Control-Allow-Methods "GET, POST, OPTIONS, PUT, DELETE"
		Access-Control-Allow-Headers "Origin, Content-Type, Authorization, Accept"
		Access-Control-Allow-Credentials true
		Vary Origin
	}

	@options {
		method OPTIONS
		header Origin https://scan.vrg.rocks
	}
	respond @options 204

	reverse_proxy http://homebox:7745
}

