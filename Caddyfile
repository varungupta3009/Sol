# Jellyfin Media Streaming Server (Protected via Jellyfin Native Auth & OIDC SSO Plugin)
watch.vrg.rocks, jellyfin.vrg.rocks {
	import security_headers
	reverse_proxy http://jellyfin:8096 {
		transport http {
			read_buffer 32768
			write_buffer 32768
			keepalive 120s
		}
	}
}

