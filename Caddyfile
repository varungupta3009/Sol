# 3. MEDIA & SERVARR SUITE (compose/media.yml)
# ================================================================

# Jellyfin Media Streaming Server (Optimized streaming buffers; native direct-play bypass)
watch.vrg.rocks, jellyfin.vrg.rocks {
	import security_headers
	reverse_proxy http://jellyfin:8096 {
		transport http {
			read_buffer 32768
			write_buffer 32768
			keepalive 120s
		}
	}
}

# Jellyfin Native Metal Instance (macOS Bare-Metal VideoToolbox on host port 8097)
metal.vrg.rocks {
	import security_headers
	reverse_proxy http://host.docker.internal:8097 {
		transport http {
			read_buffer 32768
			write_buffer 32768
			keepalive 120s
		}
	}
}

