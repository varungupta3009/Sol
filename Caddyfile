# ================================================================
# Sol Ingress Gateway - Master Caddyfile (*.vrg.rocks)
# ================================================================
# Host: Apple Silicon M1 Pro (macOS / OrbStack)
# Reverse Proxy: Caddy v2 with HTTP/3 (QUIC) & Let's Encrypt TLS
# Auth Engine: Tinyauth v5 (Zero-Click Google SSO, Native OIDC & Forward Auth)
# ================================================================

# ----------------------------------------------------------------
# Global Options
# ----------------------------------------------------------------
{
	log {
		output stdout
		format console
		level INFO
	}
}

# ----------------------------------------------------------------
# Reusable Snippets
# ----------------------------------------------------------------

# Text & Asset Compression
(optimize) {
	encode zstd gzip
}

# Baseline Security Headers
(security_headers) {
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		-Server
	}
}

# Forward-Auth Middleware (Provider-Agnostic: Tinyauth Active / Authentik Standby)
(forward_auth) {
	forward_auth tinyauth:3000 {
		uri /api/auth/caddy
		copy_headers Remote-User Remote-Name Remote-Email Remote-Groups Remote-Sub
		trusted_proxies private_ranges
	}
	# Standby Authentik body (swap in when running --profile standby authentik-server):
	# forward_auth authentik-server:9000 {
	# 	uri /outpost.goauthentik.io/auth/caddy
	# 	copy_headers X-Authentik-Username X-Authentik-Groups X-Authentik-Entitlements X-Authentik-Email X-Authentik-Name X-Authentik-Uid X-Authentik-Jwt X-Authentik-Meta-Jwks X-Authentik-Meta-Outpost X-Authentik-Meta-Provider X-Authentik-Meta-App X-Authentik-Meta-Version
	# 	trusted_proxies private_ranges
	# }
}

# Static Website Engine (Handles routing, clean URLs, compression & error fallbacks)
(static_site) {
	import optimize
	import security_headers
	try_files {path} {path}.html {path}/ =404
	file_server
	handle_errors {
		rewrite * /{err.status_code}.html
		file_server
	}
}

# ================================================================
# 1. CORE INFRASTRUCTURE (compose/core.yml)
# ================================================================

# Primary Identity & OpenID Connect (OIDC) Provider (Tinyauth v5)
auth.vrg.rocks {
	import optimize
	import security_headers
	reverse_proxy http://tinyauth:3000
}

# Auth Domain Aliases -> Canonical auth.vrg.rocks
login.vrg.rocks, tinyauth.vrg.rocks {
	import optimize
	import security_headers
	redir https://auth.vrg.rocks{uri} permanent
}

# Arcane Docker Management (Protected via Native OIDC with OIDC_AUTO_REDIRECT_TO_PROVIDER=true)
arcane.vrg.rocks {
	import optimize
	import security_headers
	reverse_proxy http://arcane:3552
}

# Physical Router Gateway (Admin-Only via Tinyauth Per-App ACL)
router.vrg.rocks {
	import optimize
	import security_headers
	import forward_auth
	reverse_proxy http://192.168.50.1
}

