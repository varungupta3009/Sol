# ================================================================
# Sol Home Server - Master Environment Template (.env.example)
# ================================================================
# Copy this file to '.env' and populate with your own secrets.
# ================================================================

# ----------------------------------------------------------------
# --- SYSTEM & GLOBAL SETTINGS
# ----------------------------------------------------------------
TZ=Asia/Kolkata
PUID=501
PGID=20
CORE_PASSWORD=your_secure_master_password
ACME_EMAIL=admin@example.com

# ----------------------------------------------------------------
# --- HOST PATH MAPPINGS & DRIVES
# ----------------------------------------------------------------
DOCKER_BASE_DIR=/Users/vrg/Documents/Sol
DOCKER_CONFIG_DIR=${DOCKER_BASE_DIR}/config
DOCKER_DATA_DIR=${DOCKER_BASE_DIR}/data
DOCKER_LOGS_DIR=${DOCKER_BASE_DIR}/logs

# External Mass Storage Drives
EXTERNAL_DRIVE_00=/Volumes/PANOPTICON
EXTERNAL_DRIVE_01=/Volumes/PHOENIX

# ----------------------------------------------------------------
# --- TINYAUTH v5 FORWARD-AUTH & OIDC PROVIDER (Primary at auth.vrg.rocks)
# ----------------------------------------------------------------
TINYAUTH_APPURL=https://auth.vrg.rocks
# Google OAuth 2.0 Web Client (Authorized redirect URI: https://auth.vrg.rocks/api/oauth/callback/google)
GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-your_google_oauth_client_secret
TINYAUTH_OAUTH_WHITELIST=you@gmail.com
TINYAUTH_ADMIN_EMAILS=you@gmail.com
# Silent Google OAuth auto-redirect
TINYAUTH_OAUTH_AUTOREDIRECT=google
# Break-glass local admin user (Generate via: docker run --rm -it ghcr.io/tinyauthapp/tinyauth:v5 user create --interactive)
TINYAUTH_USERS='vrg:$2a$10$replace_with_bcrypt_hash'

# --- Tinyauth Built-in OIDC Provider Clients (Generate via: docker exec tinyauth tinyauth oidc create <name>)
TINYAUTH_OIDC_PAPERLESS_CLIENT_ID=your_paperless_oidc_uuid
TINYAUTH_OIDC_PAPERLESS_CLIENT_SECRET=ta-your_paperless_oidc_secret
TINYAUTH_OIDC_ARCANE_CLIENT_ID=your_arcane_oidc_uuid
TINYAUTH_OIDC_ARCANE_CLIENT_SECRET=ta-your_arcane_oidc_secret
TINYAUTH_OIDC_HOMEBOX_CLIENT_ID=your_homebox_oidc_uuid
TINYAUTH_OIDC_HOMEBOX_CLIENT_SECRET=ta-your_homebox_oidc_secret
TINYAUTH_OIDC_AIRTRAIL_CLIENT_ID=your_airtrail_oidc_uuid
TINYAUTH_OIDC_AIRTRAIL_CLIENT_SECRET=ta-your_airtrail_oidc_secret
TINYAUTH_OIDC_CODER_CLIENT_ID=your_coder_oidc_uuid
TINYAUTH_OIDC_CODER_CLIENT_SECRET=ta-your_coder_oidc_secret
TINYAUTH_OIDC_READECK_CLIENT_ID=your_readeck_oidc_uuid
TINYAUTH_OIDC_READECK_CLIENT_SECRET=ta-your_readeck_oidc_secret
TINYAUTH_OIDC_JELLYFIN_CLIENT_ID=your_jellyfin_oidc_uuid
TINYAUTH_OIDC_JELLYFIN_CLIENT_SECRET=ta-your_jellyfin_oidc_secret

# --- LLDAP Lightweight Rust LDAP Directory (ldap.vrg.rocks / Jellyfin & Seerr Auth)
LLDAP_TAG=stable
LLDAP_JWT_SECRET=generate_with_openssl_rand_hex_32
LLDAP_KEY_SEED=generate_with_openssl_rand_hex_32_never_change
LLDAP_ADMIN_PASSWORD=your_secure_master_password

# ----------------------------------------------------------------
# --- ARCANE DOCKER MANAGEMENT
# ----------------------------------------------------------------
ARCANE_ENCRYPTION_KEY=generate_with_openssl_rand_hex_32
ARCANE_JWT_SECRET=generate_with_openssl_rand_hex_32
ARCANE_OIDC_CLIENT_ID=${TINYAUTH_OIDC_ARCANE_CLIENT_ID}
ARCANE_OIDC_CLIENT_SECRET=${TINYAUTH_OIDC_ARCANE_CLIENT_SECRET}
ARCANE_OIDC_ISSUER_URL=https://auth.vrg.rocks
ARCANE_OIDC_PROVIDER_NAME="Google SSO"
ARCANE_OIDC_SCOPES="openid email profile"
ARCANE_OIDC_MERGE_ACCOUNTS=true

# ----------------------------------------------------------------
# --- TORRENTING & DOWNLOADS (qBittorrent / QUI)
# ----------------------------------------------------------------
QBITTORRENT_WEBUI_PORT=8080
QBITTORRENT_TORRENTING_PORT=42069

# ----------------------------------------------------------------
# --- PAPERLESS-NGX DOCUMENT MANAGEMENT
# ----------------------------------------------------------------
USERMAP_UID=501
USERMAP_GID=20
PAPERLESS_URL=https://docs.vrg.rocks
PAPERLESS_SECRET_KEY=generate_with_openssl_rand_base64_32
PAPERLESS_TIME_ZONE=Asia/Kolkata
PAPERLESS_OCR_LANGUAGE=eng+hin+kan+pan
PAPERLESS_OCR_LANGUAGES="hin kan pan"
PAPERLESS_CONSUMER_RECURSIVE=true
PAPERLESS_CONSUMER_SUBDIRS_AS_TAGS=true
PAPERLESS_FILENAME_DATE_ORDER=YMD
PAPERLESS_DB_NAME=paperless
PAPERLESS_DB_USER=paperless
PAPERLESS_DB_PASS=your_paperless_postgres_password
PAPERLESS_APPS=allauth.socialaccount.providers.openid_connect
PAPERLESS_SOCIALACCOUNT_PROVIDERS='{"openid_connect":{"OAUTH_PKCE_ENABLED":true,"APPS":[{"provider_id":"tinyauth","name":"Google SSO","client_id":"your_paperless_oidc_uuid","secret":"ta-your_paperless_oidc_secret","settings":{"server_url":"https://auth.vrg.rocks/.well-known/openid-configuration","fetch_userinfo":true}}],"SCOPE":["openid","profile","email"]}}'
PAPERLESS_LOGOUT_REDIRECT_URL=https://auth.vrg.rocks/logout

# ----------------------------------------------------------------
# --- DEVELOPER WORKSPACES (Code-Server & Coder)
# ----------------------------------------------------------------
CODE_SERVER_HASHED_PASSWORD=your_argon2_password_hash
CODER_ACCESS_URL=https://coder.vrg.rocks

# ----------------------------------------------------------------
# --- MONITORING, DASHBOARD & STANDBY AGENTS (Glance, Beszel, Unpackerr)
# ----------------------------------------------------------------
# Glance Custom API Keys (Leave blank until populated; Glance renders setup hints when empty)
JELLYFIN_API_KEY=
SEERR_API_KEY=
RADARR_API_KEY=
SONARR_API_KEY=
PROWLARR_API_KEY=
PAPERLESS_API_KEY=
GITHUB_TOKEN=

# Standby Monitoring & Unpackerr
BESZEL_AGENT_KEY=your_beszel_agent_public_key
BESZEL_AGENT_TOKEN=your_beszel_agent_uuid_token
LIDARR_API_KEY=your_lidarr_api_key

# ----------------------------------------------------------------
# --- UTILITIES & AUTOMATION (Backrest, Homebox, n8n, Vaultwarden)
# ----------------------------------------------------------------
RESTIC_PASSWORD=your_secure_restic_repository_password
HBOX_AUTH_API_KEY_PEPPER=your_hex_pepper_here
N8N_DOMAIN_NAME=vrg.rocks
N8N_SUBDOMAIN=n8n
N8N_SSL_EMAIL=your_email@example.com
BW_DOMAIN=vault.vrg.rocks
BW_DB_PROVIDER=sqlite
BW_INSTALLATION_ID=your_bitwarden_installation_id
BW_INSTALLATION_KEY=your_bitwarden_installation_key
